# ReadAloud config — copy to .env and fill in your key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# any OpenRouter model id; ":free" endpoints work too, e.g.
# google/gemini-2.0-flash-exp:free  (must be vision-capable for images/PDFs)
READALOUD_MODEL=google/gemini-2.5-flash
# OpenRouter speech model; Gareth is the default HeyGen voice.
READALOUD_TTS_MODEL=heygen/heygen-voice-1-turbo:free
READALOUD_VOICE=gareth
# HeyGen voices: gareth, nadine, tabitha, bram, noelle, meredith,
# sabrina, lucian, weston, vincent
PORT=8765
